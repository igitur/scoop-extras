{
    "version": "2.18.0.1",
    "description": "A Windows Shell Interface to Git",
    "homepage": "https://tortoisegit.org",
    "license": "GPL-2.0-only",
    "notes": [
        "To enable TortoiseGit context menus:",
        "  reg import \"$dir\\tortoisegit-install.reg\"",
        "",
        "Optional file associations:",
        "  reg import \"$dir\\tortoisegit-install-file-assoc.reg\"",
        "",
        "Optional icon overlays (REQUIRES ADMIN - run as administrator):",
        "  reg import \"$dir\\tortoisegit-install-overlays.reg\"",
        "  Stop-Process -Name explorer -Force"
    ],
    "architecture": {
        "64bit": {
            "url": [
                "https://download.tortoisegit.org/tgit/2.18.0.0/TortoiseGit-2.18.0.1-64bit.msi",
                "https://raw.githubusercontent.com/igitur/scoop-extras/add-tortoisegit/scripts/tortoisegit/tortoisegit-install.reg.templ",
                "https://raw.githubusercontent.com/igitur/scoop-extras/add-tortoisegit/scripts/tortoisegit/tortoisegit-install-overlays.reg.templ",
                "https://raw.githubusercontent.com/igitur/scoop-extras/add-tortoisegit/scripts/tortoisegit/tortoisegit-install-file-assoc.reg.templ",
                "https://raw.githubusercontent.com/igitur/scoop-extras/add-tortoisegit/scripts/tortoisegit/tortoisegit-uninstall.reg"
            ],
            "hash": [
                "cbf7d52aa0ecca665521e14d8d1a4b6cda52a4bc13de45f49084e15571c77410",
                "48ae5383692d0de4bec81a215ef7f7658dd45029f1c90a9494af54788705c42d",
                "86ec9933fe9faadf4d1c4a6e088219678ee2ca3eec10657068585201d2e63e52",
                "fd53fe77a38f5957ad40da4dd692f2ddbfe0aa8f0ca8ecef6e7be93738bed43d",
                "fe41e32f48e4f6d6ab37a1b7198978934ef32a500ca932aa040fe9440e435cc8"
            ]
        },
        "32bit": {
            "url": "https://download.tortoisegit.org/tgit/2.18.0.0/TortoiseGit-2.18.0.1-32bit.msi",
            "hash": "851cfeffbf2fe0c522eaed6b88b2695cccb4555161f8afa0a77f17902fd6a9a3"
        }
    },
    "extract_dir": "Program Files\\TortoiseGit",
    "pre_install": [
        "$escdir = \"$dir\" -replace '\\\\', '\\\\'",
        "'install', 'install-overlays', 'install-file-assoc' | ForEach-Object {",
        "    if (Test-Path \"$dir\\tortoisegit-$_.reg.templ\") {",
        "        (Get-Content \"$dir\\tortoisegit-$_.reg.templ\") -replace '%TGITHOME%', \"$escdir\" | Set-Content -LiteralPath \"$dir\\tortoisegit-$_.reg\" -Encoding Ascii",
        "        Remove-Item \"$dir\\tortoisegit-$_.reg.templ\"",
        "    }",
        "}"
    ],
    "shortcuts": [
        [
            "bin\\TortoiseGitIDiff.exe",
            "TortoiseGitIDiff"
        ],
        [
            "bin\\TortoiseGitMerge.exe",
            "TortoiseGitMerge"
        ],
        [
            "bin\\TortoiseGitProc.exe",
            "TortoiseGit",
            "/command:rtfm"
        ],
        [
            "bin\\TortoiseGitBlame.exe",
            "TortoiseGitBlame"
        ],
        [
            "bin\\TortoiseGitProc.exe",
            "TortoiseGit Settings",
            "/command:settings"
        ]
    ],
    "checkver": {
        "script": [
            "$url = 'https://download.tortoisegit.org/tgit/'",
            "$content = (Invoke-WebRequest $url).Content",
            "$r = 'diricon diricon-folder\"></span></td><td><a href=([\\d\\.]+)/ >'",
            "if (!($content -match $r)) { error \"Could not match $r in $url\"; break }",
            "$directory = $matches[1]",
            "$url = \"$($url)$directory/\"",
            "$content = (Invoke-WebRequest $url).Content",
            "$r = '>TortoiseGit-([\\d\\.]+)-64bit.msi<'",
            "if (!($content -match $r)) { error \"Could not match $r in $url\"; break }",
            "$match = (Select-String -Pattern $r -InputObject $content -AllMatches).Matches | Select-Object -Last 1",
            "$version = $match.Groups[1].Value",
            "Write-Output $directory $version"
        ],
        "regex": "(?<directory>[\\d\\.]+) ([\\d\\.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.tortoisegit.org/tgit/$matchDirectory/TortoiseGit-$version-64bit.msi"
            },
            "32bit": {
                "url": "https://download.tortoisegit.org/tgit/$matchDirectory/TortoiseGit-$version-32bit.msi"
            }
        }
    }
}
