; User configuration

[HKEY_CURRENT_USER\Software\TortoiseGit]
"TortoiseGit"="TortoiseGit"
"TortoiseMerge"="TortoiseGitMerge"
"TortoiseGitBlame"="TortoiseGitBlame"
"TortoiseIDiff"="TortoiseGitIDiff"

; URL Protocol Handlers (HKCU - no admin rights required)

[HKEY_CURRENT_USER\Software\Classes\tgit]
@="URL: TGit Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\tgit\shell\open\command]
@="\"%TGITHOME%\\bin\\TortoiseGitProc.exe\" /urlhandler:\"%1\""

[HKEY_CURRENT_USER\Software\Classes\git]
@="URL: Git Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\git\shell\open\command]
@="\"%TGITHOME%\\bin\\TortoiseGitProc.exe\" /command:clone /url:\"%1\""

[HKEY_CURRENT_USER\Software\Classes\github-windows]
@="URL: Github-Windows Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\github-windows\shell\open\command]
@="\"%TGITHOME%\\bin\\TortoiseGitProc.exe\" /urlhandler:\"%1\""

[HKEY_CURRENT_USER\Software\Classes\smartgit]
@="URL: Smartgit Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\smartgit\shell\open\command]
@="\"%TGITHOME%\\bin\\TortoiseGitProc.exe\" /urlhandler:\"%1\""

[HKEY_CURRENT_USER\Software\Classes\x-github-client]
@="URL: X-Github-Client Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\x-github-client\shell\open\command]
@="\"%TGITHOME%\\bin\\TortoiseGitProc.exe\" /urlhandler:\"%1\""

[HKEY_CURRENT_USER\Software\Classes\TortoiseGit.UrlHandler\shell\open]
"Icon"="\"%TGITHOME%\\bin\\TortoiseGitProc.exe\""

[HKEY_CURRENT_USER\Software\Classes\TortoiseGit.UrlHandler\shell\open\command]
@="\"%TGITHOME%\\bin\\TortoiseGitProc.exe\" /urlhandler:\"%1\""

[HKEY_CURRENT_USER\Software\Classes\TortoiseGit.GitUrlHandler\shell\open]
"Icon"="\"%TGITHOME%\\bin\\TortoiseGitProc.exe\""

[HKEY_CURRENT_USER\Software\Classes\TortoiseGit.GitUrlHandler\shell\open\command]
@="\"%TGITHOME%\\bin\\TortoiseGitProc.exe\" /command:clone /url:\"%1\""
