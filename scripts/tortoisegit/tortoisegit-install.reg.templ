REGEDIT4

; TortoiseGit Portable Registry Template (HKCU only - no admin required)
; Shell integration handlers registered under HKEY_CURRENT_USER\Software\Classes
; Note: Icon overlays require admin rights - see tortoisegit-install-overlays.reg

; Shell extension CLSIDs (TortoiseGitStub.dll handlers)

[HKEY_CURRENT_USER\Software\Classes\CLSID\{451C7E59-058F-450A-8C42-FE9A12A302FC}]
@="TortoiseGit"

[HKEY_CURRENT_USER\Software\Classes\CLSID\{451C7E59-058F-450A-8C42-FE9A12A302FC}\InProcServer32]
@="%TGITHOME%\\bin\\TortoiseGitStub.dll"
"ThreadingModel"="Apartment"

